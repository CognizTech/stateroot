<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="StateRoot"
           Manufacturer="CognizTech"
           Version="$(ProductVersion)"
           UpgradeCode="{835594F4-F7DA-42D9-9806-96D037B354B7}"
           Scope="perUser"
           InstallerVersion="500"
           Language="1033"
           Compressed="yes">

    <SummaryInformation Description="StateRoot command-line interface"
                        Manufacturer="CognizTech" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of StateRoot is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LOCALPROGRAMSFOLDER" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="StateRoot">
          <Component Id="StateRootExecutable"
                     Guid="{7AE30BE2-0F6C-400A-A0B6-A8D19F3489D6}"
                     Bitness="always64">
            <File Id="StateRootExe"
                  Source="$(SourceExe)"
                  Name="stateroot.exe"
                  KeyPath="yes" />
            <Environment Id="StateRootUserPath"
                         Name="PATH"
                         Value="[INSTALLFOLDER]"
                         Action="set"
                         Part="last"
                         Permanent="no"
                         System="no" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Feature Id="StateRootFeature"
             Title="StateRoot"
             Description="StateRoot command-line interface"
             Level="1">
      <ComponentRef Id="StateRootExecutable" />
    </Feature>

    <!-- Keep setup in the CLI and launch that same interactive wizard after
         a fresh GUI install. The ExitDialog event is not published by quiet
         installs, repairs, or uninstalls. -->
    <CustomAction Id="LaunchStateRootSetup"
                  FileRef="StateRootExe"
                  ExeCommand="setup"
                  Execute="immediate"
                  Impersonate="yes"
                  Return="asyncNoWait" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchStateRootSetup"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT"
              Value="Complete setup to connect StateRoot to your AI coding harnesses." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Run StateRoot setup now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(LicenseRtf)" />
  </Package>
</Wix>
